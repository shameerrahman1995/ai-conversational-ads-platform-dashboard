# ---- Core ----
NODE_ENV=development

# ---- API ----
API_PORT=4000
API_BASE_URL=http://localhost:4000

# ---- Web ----
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ---- Postgres ----
DATABASE_URL=postgresql://acp:acp@localhost:5432/acp?schema=public

# ---- Redis (queues, sessions, rate limits) ----
REDIS_URL=redis://localhost:6379

# ---- Object storage (S3-compatible / MinIO locally) ----
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=acp-minio
S3_SECRET_ACCESS_KEY=acp-minio-secret
S3_BUCKET=acp-assets

# ---- AI model gateway (provider-neutral; Anthropic first) ----
# NOTE: never expose provider tokens to the browser. Server-side only.
ANTHROPIC_API_KEY=
MODEL_GATEWAY_DEFAULT_MODEL=claude-sonnet-5
