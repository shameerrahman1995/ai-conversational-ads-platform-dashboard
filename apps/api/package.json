{
  "name": "@acp/api",
  "version": "0.0.0",
  "private": true,
  "exports": {
    ".": "./dist/main.js",
    "./app-module": {
      "types": "./dist/app.module.d.ts",
      "default": "./dist/app.module.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "typesVersions": {
    "*": {
      "app-module": [
        "./dist/app.module.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run test/integration",
    "clean": "rm -rf dist .turbo coverage *.tsbuildinfo"
  },
  "dependencies": {
    "@acp/config": "workspace:*",
    "@acp/connectors": "workspace:*",
    "@acp/crm": "workspace:*",
    "@acp/db": "workspace:*",
    "@acp/jobs": "workspace:*",
    "@acp/policy": "workspace:*",
    "@acp/shared-types": "workspace:*",
    "@aws-sdk/client-s3": "3.1125.0",
    "@aws-sdk/s3-request-presigner": "3.1125.0",
    "@nestjs/common": "12.0.1",
    "@nestjs/core": "12.0.1",
    "@nestjs/jwt": "^12.0.1",
    "@nestjs/platform-express": "12.0.1",
    "@nestjs/swagger": "12.0.1",
    "@nestjs/throttler": "^6.5.0",
    "bullmq": "6.3.4",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "^8.3.0",
    "ioredis": "5.4.2",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.0",
    "@nestjs/testing": "^12.0.1",
    "@types/node": "26.4.1",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "3.2.7",
    "supertest": "^7.2.2",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  }
}
